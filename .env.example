# AutonomOS Environment Configuration Template
# All providers use Python standard library with zero external runtime dependencies.

# -----------------------------------------------------------------------------
# AI Inference Providers (OpenAI-compatible REST endpoints supported natively)
# -----------------------------------------------------------------------------
# Google Gemini (Gemini 2.0 Flash, Flash-Lite, 1.5 Pro)
# Free tier: 15 RPM / 1,500 requests/day at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Direct OpenAI (GPT-4o, GPT-4o-mini, o3-mini)
OPENAI_API_KEY=your_openai_api_key_here

# Groq Cloud (Ultra-fast Llama 3.3 70B & DeepSeek R1 Distill)
# Generous free tier at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter (Multi-model aggregator with free & cloud models)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Local Ollama Inference (Zero cloud, runs on localhost)
OLLAMA_BASE_URL=http://localhost:11434

# -----------------------------------------------------------------------------
# Web Search Configuration
# -----------------------------------------------------------------------------
# SEARCH_PROVIDER options: "auto" (default), "duckduckgo", "tavily", or "mock"
# When set to "auto" and TAVILY_API_KEY is omitted, DuckDuckGo keyless search is used automatically.
SEARCH_PROVIDER=auto
TAVILY_API_KEY=your_tavily_key_here

# -----------------------------------------------------------------------------
# Community & Code Intelligence
# -----------------------------------------------------------------------------
# GitHub Personal Access Token (for GitHub repository and discussion crawling)
GITHUB_TOKEN=your_github_token_here

# Reddit Public or App Access (Optional: works with default public JSON endpoints)
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=AutonomOS-Researcher/1.0

# Stack Exchange API Key (Optional: 300 req/day keyless, 10,000 req/day with key)
STACKEXCHANGE_API_KEY=your_stackexchange_key_here

# -----------------------------------------------------------------------------
# Database & Storage
# -----------------------------------------------------------------------------
AUTONOMOS_DB_PATH=autonomos.db
